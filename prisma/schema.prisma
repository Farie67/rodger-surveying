generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is used by the Prisma CLI for local schema management.
// At runtime, lib/prisma.ts connects through @prisma/adapter-libsql using
// TURSO_DATABASE_URL (local file or remote libsql:// URL) and TURSO_AUTH_TOKEN.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id                     String   @id @default(uuid())
  reference              String   @unique
  fullName               String
  companyName            String?
  phone                  String
  email                  String
  province               String
  town                   String
  serviceRequired        String
  projectSize            String
  description            String
  commencementDate       String
  additionalRequirements String?
  status                 String   @default("New")
  createdAt              DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
